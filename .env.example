# FaceProof — Face ID + Blockchain Verification Pipeline
# HH Goa 2026 Shortlisting Task 3

# --- SerpAPI (reverse image search) ---
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_LANGUAGE=en
SERPAPI_COUNTRY=us

# --- Ethereum Sepolia (blockchain) ---
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_PRIVATE_KEY=your_metamask_private_key_here
CONTRACT_ADDRESS=your_deployed_contract_address_here
BLOCKCHAIN_CHAIN_ID=11155111
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# --- Search Provider ---
SEARCH_PROVIDER=serpapi
FACE_MATCH_THRESHOLD=0.35

